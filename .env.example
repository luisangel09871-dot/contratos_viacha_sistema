# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a GitHub.
DATABASE_URL=postgres://postgres:TU_CONTRASENA@localhost:5432/contratos_viacha
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Chatbot con Gemini (opcional). Sin clave, el chatbot responde con plantillas.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-lite-latest

# Correo (opcional). Sin esto, las alertas se muestran en la consola del servidor.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=contratos@gamviacha.local
